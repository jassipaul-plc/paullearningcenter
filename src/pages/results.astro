---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CTABand from '../components/CTABand.astro';
import TalkToUs from '../components/TalkToUs.astro';
import { testimonials } from '../data/testimonials.js';
import { site } from '../data/site.js';
import { resultSessions, resultStats } from '../data/results.js';

const stats = resultStats();
// Per-semester honored count = perfect scores + all tier names
const honored = (s) =>
  s.perfect.students.length +
  s.tiers.reduce((t, tier) => t + tier.groups.reduce((sum, g) => sum + g.students.length, 0), 0);
---
<Base
  title="Results & Reviews"
  description="Real results from Paul Learning Center students — perfect scores and 90%+ finishes in high school finals from Math 1 to AP Calculus, plus parent reviews."
>
  <PageHeader
    eyebrow="Results"
    title="Published Student Results"
    lede="Real outcomes from high school finals — three semesters, verified and public."
  />

  <!-- Big hero stats — aggregate proof -->
  <section class="section">
    <div class="container">
      <div class="big-stats">
        <div class="big-stat">
          <div class="n">{stats.perfect}</div>
          <div class="l">Perfect scores</div>
        </div>
        <div class="big-stat">
          <div class="n">{stats.ninety}</div>
          <div class="l">Scored 90%+</div>
        </div>
        <div class="big-stat">
          <div class="n">{stats.eighty}</div>
          <div class="l">Scored 80%+</div>
        </div>
      </div>
      <p class="stat-note muted">Across three published semesters of high school finals.</p>
    </div>
  </section>

  <!-- Per-semester highlights — compact, scannable -->
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Semester by Semester</span>
        <h2>The Achievements Behind the Numbers</h2>
      </div>

      <div class="sessions">
        {resultSessions.map((s) => (
          <article class="card session" id={s.id}>
            <div class="session-body">
              <div class="session-main">
                <h3>{s.title}</h3>
                <p class="honored muted">{honored(s)} students on the honor roll</p>

                <div class="perfect-strip">
                  <div class="score-shout">
                    <span class="score">{s.perfect.score}</span>
                    <span class="score-meta">
                      <span class="score-word">Perfect Score</span>
                      <span class="score-subject">{s.perfect.subject}</span>
                    </span>
                  </div>
                  <div class="chips">
                    {s.perfect.students.map((n) => <span class="chip">{n}</span>)}
                  </div>
                </div>

                <div class="tier-counts">
                  {s.tiers.map((tier) => (
                    <div class="tier-item">
                      <span class="count">{tier.groups.reduce((sum, g) => sum + g.students.length, 0)}</span>
                      <span class="tier-name">students at {tier.label}</span>
                    </div>
                  ))}
                </div>
              </div>

              <a class="flyer-thumb" href={s.flyer} target="_blank" rel="noopener">
                <img src={s.flyer} alt={`Original results announcement — ${s.title}`} loading="lazy" />
                <span class="flyer-cap">View original flyer</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Reviews</span>
        <h2>What Families Tell Us</h2>
        <p>All reviews are public on our <a href={site.facebookReviews} target="_blank" rel="noopener">Facebook page</a> — read them at the source.</p>
      </div>
      <div class="card-grid">
        {testimonials.map((t) => <TestimonialCard t={t} />)}
      </div>
    </div>
  </section>

  <TalkToUs
    title="Want results like these?"
    text="Message us about your child's grade and goals — we'll tell you honestly what progress to expect and which program fits."
  />

  <CTABand
    title="Your child could be next"
    text="Join the families seeing real progress — enroll for School Session 2026-27."
  />
</Base>

<style>
  /* Big hero stats — same treatment as ResultsShout */
  .big-stats {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 auto;
    max-width: 56rem;
    text-align: center;
  }
  @media (max-width: 640px) { .big-stats { gap: 1.75rem; grid-template-columns: 1fr; } }
  .big-stat .n {
    color: var(--teal-deep);
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5.8vw, 4rem);
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    line-height: 1;
  }
  .big-stat .l { color: var(--muted); font-size: 1.05rem; font-weight: 700; margin-top: 0.4rem; }
  .stat-note { font-size: 0.95rem; margin-top: 1.2rem; text-align: center; }

  /* Compact semester cards */
  .sessions { display: flex; flex-direction: column; gap: 1.8rem; }
  .session { padding: 1.8rem 2rem 1.6rem; }
  /* Thumbnail centers against the full card so it doesn't leave a hole
     under itself when the content column runs taller */
  .session-body { align-items: center; display: flex; gap: 2.2rem; }
  .session-main { flex: 1; min-width: 0; }
  .session-main h3 { margin: 0 0 0.2rem; }
  .honored { font-size: 0.95rem; margin: 0 0 1.2rem; }

  /* Flyer thumbnail — the proof, aligned right */
  .flyer-thumb {
    flex: 0 0 124px;
    text-decoration: none;
    text-align: center;
  }
  .flyer-thumb img {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    display: block;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    width: 100%;
  }
  .flyer-thumb:hover img { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .flyer-cap {
    color: var(--teal-ink);
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    margin-top: 0.45rem;
  }
  .flyer-thumb:hover .flyer-cap { text-decoration: underline; }
  @media (max-width: 640px) {
    .session-body { align-items: stretch; flex-direction: column-reverse; gap: 1.4rem; }
    .flyer-thumb { align-self: flex-start; flex: 0 0 auto; width: 116px; }
  }

  .perfect-strip {
    background: linear-gradient(120deg, var(--teal-deep), var(--teal-ink));
    border-radius: var(--radius);
    margin-bottom: 1.4rem;
    padding: 1.1rem 1.4rem 1.2rem;
  }

  /* The achievement, shouted: giant golden score */
  .score-shout {
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    gap: 0.9rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .score {
    color: #ffd166;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 0.9;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }
  .score-meta { display: flex; flex-direction: column; gap: 0.15rem; }
  .score-word {
    color: #ffe9a8;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .score-subject { color: #ffffff; font-size: 1.05rem; font-weight: 700; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .chip {
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.28rem 0.85rem;
  }

  /* Tier summary — counts, not name lists */
  .tier-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
  }
  .tier-item { align-items: baseline; display: flex; gap: 0.5rem; }
  .tier-item .count {
    color: var(--teal-deep);
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .tier-item .tier-name { color: var(--muted); font-size: 0.95rem; font-weight: 600; }
</style>
