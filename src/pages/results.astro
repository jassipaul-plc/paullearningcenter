---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CTABand from '../components/CTABand.astro';
import TalkToUs from '../components/TalkToUs.astro';
import { testimonials } from '../data/testimonials.js';
import { site } from '../data/site.js';
import { resultSessions, resultStats } from '../data/results.js';

const stats = resultStats();
---
<Base
  title="Results & Reviews"
  description="Real results from Paul Learning Center students — perfect scores and 90%+ finishes in high school finals from Math 1 to AP Calculus, plus parent reviews."
>
  <PageHeader
    eyebrow="Results"
    title="Published Student Results"
    lede="Real outcomes from high school finals — three semesters, verified and public."
  />

  <!-- Big hero stats — aggregate proof -->
  <section class="section">
    <div class="container">
      <div class="big-stats hero">
        <div class="big-stat">
          <div class="n">{stats.perfect}</div>
          <div class="l">Perfect scores</div>
        </div>
        <div class="big-stat">
          <div class="n">{stats.ninety}</div>
          <div class="l">Scored 90%+</div>
        </div>
        <div class="big-stat">
          <div class="n">{stats.eighty}</div>
          <div class="l">Scored 80%+</div>
        </div>
      </div>
      <p class="text-center stat-note">Across three published semesters of high school finals.</p>
    </div>
  </section>

  <!-- Per-semester highlights — compact, scannable -->
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Semester by Semester</span>
        <h2>The Achievements Behind the Numbers</h2>
      </div>

      <div class="sessions">
        {resultSessions.map((s) => (
          <article class="card session compact" id={s.id}>
            <div class="session-grid">
              <div>
                <h3>{s.title}</h3>
                <p class="text-small muted">From {s.perfect.label}</p>
              </div>
              <a class="result-link" href={s.flyer} target="_blank" rel="noopener">View original flyer</a>
            </div>

            {s.perfect.students.length > 0 && (
              <div class="perfect-strip">
                <strong>{s.perfect.label}:</strong>
                <div class="chips">
                  {s.perfect.students.map((n) => <span class="chip">{n}</span>)}
                </div>
              </div>
            )}

            <div class="tier-counts">
              {s.tiers.map((tier) => (
                <div class="tier-item">
                  <span class="count">{tier.groups.reduce((sum, g) => sum + g.students.length, 0)}</span>
                  <span class="tier-name">{tier.label}</span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Reviews</span>
        <h2>What Families Tell Us</h2>
        <p>All reviews are public on our <a href={site.facebookReviews} target="_blank" rel="noopener">Facebook page</a> — read them at the source.</p>
      </div>
      <div class="card-grid">
        {testimonials.map((t) => <TestimonialCard t={t} />)}
      </div>
    </div>
  </section>

  <TalkToUs
    title="Want results like these?"
    text="Message us about your child's grade and goals — we'll tell you honestly what progress to expect and which program fits."
  />

  <CTABand
    title="Your child could be next"
    text="Join the families seeing real progress — enroll for School Session 2026-27."
  />
</Base>

<style>
  /* Big hero stats — same as ResultsShout but isolated to this page */
  .big-stats {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 auto;
    max-width: 56rem;
    text-align: center;
  }
  @media (max-width: 640px) { .big-stats { gap: 1.75rem; grid-template-columns: 1fr; } }
  .big-stat .n {
    color: var(--teal-deep);
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 4.8rem);
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    line-height: 1;
  }
  .big-stat .l { color: var(--muted); font-size: 1.05rem; font-weight: 700; margin-top: 0.4rem; }

  .stat-note { font-size: 0.95rem; margin-top: 1.2rem; text-align: center; }

  /* Compact semester cards — scan at a glance -->
  .sessions { display: flex; flex-direction: column; gap: 1.8rem; }
  .session.compact { padding: 1.6rem 1.8rem; }
  .session-grid {
    align-items: center;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .session-grid h3 { margin: 0; }
  .text-small { font-size: 0.9rem; }
  .result-link { color: var(--teal-ink); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .result-link:hover { text-decoration: underline; }

  .perfect-strip {
    background: linear-gradient(120deg, var(--teal-deep), var(--teal-ink));
    border-radius: var(--radius);
    margin: 0 0 1.4rem;
    padding: 0.9rem 1.2rem;
  }
  .perfect-strip strong {
    color: #ffe9a8;
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.25rem 0.8rem;
  }

  /* Tier summary — counts, not names -->
  .tier-counts { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); margin-top: 0.8rem; }
  .tier-item {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .tier-item .count { color: var(--teal-deep); font-family: var(--font-display); font-size: 1.8rem; font-weight: 800; }
  .tier-item .tier-name { color: var(--muted); font-size: 0.9rem; font-weight: 600; }
</style>
