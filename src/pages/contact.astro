---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TalkToUs from '../components/TalkToUs.astro';
import { site, whatsappUrl } from '../data/site.js';
---
<Base
  title="Contact Us"
  description="Get in touch with Paul Learning Center — chat on Messenger, send a message, or email us about programs, schedules, and enrollment for School Session 2026-27."
>
  <PageHeader
    eyebrow="Contact"
    title="Contact Us"
    lede="Tell us your child's grade and what they need help with — we'll recommend the right course. Messenger is the fastest way to reach us."
  />

  <TalkToUs
    title="Chat with us now"
    text="We answer quickest on Facebook Messenger — usually the same day. Start a chat and tell us what your child needs."
  />

  <section class="section">
    <div class="container contact-grid">
      <div>
        <h2>Send a message</h2>
        <form id="contact-form" data-mk-lead method="post" action="/api/contact">
          <div class="form-grid">
            <div>
              <label for="cf-name">Your name</label>
              <input id="cf-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div>
              <label for="cf-email">Your email</label>
              <input id="cf-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="full">
              <label for="cf-message">Message</label>
              <textarea id="cf-message" name="message" rows="5" required placeholder="Child's grade, subject, and what you're looking for…"></textarea>
            </div>
            <!-- Honeypot: bots fill it, humans never see it -->
            <div class="hp-field" aria-hidden="true">
              <label for="cf-company">Company</label>
              <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>
          </div>
          <p class="form-note">We typically reply within one business day.</p>
          <button class="btn btn-primary" type="submit">Send message</button>
          <p class="form-status" id="form-status" role="status"></p>
        </form>
      </div>

      <aside>
        <h2>Reach us directly</h2>
        <p><strong>WhatsApp</strong><br /><a href={whatsappUrl()} target="_blank" rel="noopener">Chat on WhatsApp</a></p>
        <p><strong>Messenger</strong><br /><a href={site.messenger} target="_blank" rel="noopener">Chat with Paul Learning Center</a></p>
        <p><strong>Phone</strong><br /><a href={`tel:+1${site.phone.replace(/-/g, '')}`}>{site.phone}</a></p>
        <p><strong>Email</strong><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><strong>Location</strong><br />{site.address}</p>
        <p><strong>Follow us</strong><br />
          <a href={site.facebook} target="_blank" rel="noopener">Facebook page</a><br />
          <a href={site.facebookReviews} target="_blank" rel="noopener">Reviews on Facebook</a>
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: 3.5rem;
    grid-template-columns: 3fr 2fr;
  }
  @media (max-width: 780px) { .contact-grid { grid-template-columns: 1fr; } }
  aside p { margin: 1.1rem 0; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (!status) return;
    status.textContent = 'Sending…';
    status.className = 'form-status';
    const data = Object.fromEntries(new FormData(form).entries());
    // Attach anonymous attribution so we know which campaign produced the lead
    const attr = (window as any).MarketingKit?.getAttribution?.();
    if (attr) (data as any).attribution = attr;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(String(res.status));
      window.location.href = '/thank-you/';
    } catch {
      status.textContent =
        'Sorry, the message could not be sent right now. Please email us directly at paullearningcenter@gmail.com.';
      status.className = 'form-status error';
    }
  });
</script>
