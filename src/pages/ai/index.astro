---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
---
<Base
  title="AI Learning — Coming Soon"
  description="AI-assisted learning at Paul Learning Center is coming soon."
  showAnnouncement={false}
>
  <PageHeader eyebrow="Coming Soon" title="AI Learning" />
  <section class="section">
    <div class="container narrow text-center">
      <p class="muted" style="font-size:1.2rem">
        We're building an AI-assisted learning experience to complement our
        classes — personalized practice, instant help, and progress insights.
        Stay tuned.
      </p>
      <p class="mt-2">
        <a class="btn btn-primary" href="/">Back to home</a>
      </p>
    </div>
  </section>
</Base>
