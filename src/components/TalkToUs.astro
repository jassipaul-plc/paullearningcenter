---
// Highlighted contact section — Messenger chat is the primary action.
// The m.me deep link opens a Facebook Messenger conversation with the
// PLC page (in the app on mobile, messenger.com on desktop). Clicks are
// tracked as 'messenger_click' via the marketing kit's conversionDomains.
import { site, whatsappUrl } from '../data/site.js';
const {
  title = 'Talk to Us',
  text = 'Not sure which course fits your child? Message us — tell us the grade and subject, and we’ll point you to the right track.',
} = Astro.props;
---
<section class="talk">
  <div class="container inner">
    <div class="copy">
      <span class="eyebrow">Questions?</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn-whatsapp btn-lg" href={whatsappUrl()} target="_blank" rel="noopener">
        <svg viewBox="0 0 448 512" width="19" height="19" fill="currentColor" aria-hidden="true" style="vertical-align:-3px;margin-right:.5rem">
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        Chat on WhatsApp
      </a>
      <a class="btn btn-messenger btn-lg" href={site.messenger} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" style="vertical-align:-4px;margin-right:.5rem">
          <path d="M12 2C6.5 2 2 6.14 2 11.25c0 2.88 1.42 5.45 3.66 7.14V22l3.35-1.84c.94.26 1.94.4 2.99.4 5.5 0 10-4.14 10-9.25S17.5 2 12 2zm1.06 12.44-2.56-2.73-4.99 2.73 5.49-5.82 2.62 2.72 4.93-2.72-5.49 5.82z"/>
        </svg>
        Messenger
      </a>
      <a class="btn btn-ghost btn-lg" href={`mailto:${site.email}`}>Email us</a>
    </div>
  </div>
</section>

<style>
  .talk {
    background: linear-gradient(150deg, var(--mist) 0%, #e2f0ec 100%);
    border-block: 1px solid var(--line);
  }
  .inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    padding-bottom: 3.5rem;
    padding-top: 3.5rem;
  }
  .copy { max-width: 34rem; }
  .copy h2 { margin-bottom: 0.3rem; }
  .copy p { color: var(--muted); margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
</style>
