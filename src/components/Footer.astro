---
import { site, whatsappUrl } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container cols">
    <div class="col brand-col">
      <p class="brand">Paul Learning Center</p>
      <p class="blurb">
        Personalized instruction from certified educators — helping students excel
        from elementary math through AP Calculus.
      </p>
    </div>
    <div class="col">
      <p class="head">Explore</p>
      <a href="/programs/">Programs</a>
      <a href="/results/">Results</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/ai/">AI Learning</a>
    </div>
    <div class="col">
      <p class="head">Enroll</p>
      <a href={site.session.landingPath}>{site.session.label}</a>
      <a href={site.otute.courses} target="_blank" rel="noopener">Browse courses on Otute</a>
    </div>
    <div class="col">
      <p class="head">Talk to Us</p>
      <a href={whatsappUrl()} target="_blank" rel="noopener">Chat on WhatsApp</a>
      <a href={site.messenger} target="_blank" rel="noopener">Message us on Messenger</a>
      <a href={`tel:+1${site.phone.replace(/-/g, '')}`}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <p class="addr">{site.address}</p>
      <p class="head" style="margin-top:1.2rem">Follow Us</p>
      <a href={site.facebook} target="_blank" rel="noopener">Facebook page</a>
      <a href={site.facebookReviews} target="_blank" rel="noopener">Reviews on Facebook</a>
    </div>
  </div>
  <div class="container bottom">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p>
      <a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms</a> ·
      <button type="button" class="linkish" id="cookie-settings">Cookie settings</button>
    </p>
  </div>
</footer>

<style>
  .footer { background: var(--teal-deep); color: rgba(255, 255, 255, 0.85); }
  .cols {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 2fr 1fr 1fr 1.4fr;
    padding-bottom: 2.5rem;
    padding-top: 3rem;
  }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .cols { grid-template-columns: 1fr; gap: 1.8rem; } }
  .brand { color: #ffffff; font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; margin: 0 0 0.5rem; }
  .blurb { font-size: 0.95rem; margin: 0; max-width: 32ch; }
  .head {
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0 0 0.7rem;
    text-transform: uppercase;
  }
  .col a { color: rgba(255, 255, 255, 0.85); display: block; margin: 0.35rem 0; text-decoration: none; }
  .col a:hover { color: #ffffff; text-decoration: underline; }
  .addr { font-size: 0.92rem; margin: 0.35rem 0; }

  /* Reopens the consent banner — a button for semantics, styled as a link
     so it sits naturally beside Privacy and Terms. */
  .linkish {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-decoration: underline;
  }
  .bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.9rem;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    padding-bottom: 1.4rem;
    padding-top: 1.4rem;
  }
  .bottom p { margin: 0; }
  .bottom a { color: rgba(255, 255, 255, 0.85); }
</style>

<script>
  document.getElementById('cookie-settings')?.addEventListener('click', () => {
    if (window.MarketingKit?.resetConsent) window.MarketingKit.resetConsent();
  });
</script>
