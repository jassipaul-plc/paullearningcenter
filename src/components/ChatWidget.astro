---
// Floating chat widget — fixed bottom-right on every page. The main
// button expands to two channels: WhatsApp (opens wa.me with pre-filled
// text) and Facebook Messenger (m.me deep link). Clicks are tracked as
// 'whatsapp_click' / 'messenger_click' via the marketing kit's
// conversionDomains config.
//
// Attention nudge: the toggle shakes + pulses (with a "Chat with us!"
// label) shortly after load and every 8s until the visitor opens the
// widget once. Both the nudge and the open/close animation are disabled
// by prefers-reduced-motion (the global reset kills all animation).
import { site, whatsappUrl } from '../data/site.js';
---
<div class="chat-widget" id="chat-widget">
  <div class="chat-options" id="chat-options">
    <a class="chat-opt wa" href={whatsappUrl()} target="_blank" rel="noopener" tabindex="-1">
      <span class="opt-label">WhatsApp</span>
      <span class="opt-icon" aria-hidden="true">
        <svg viewBox="0 0 448 512" width="24" height="24" fill="currentColor">
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
      </span>
    </a>
    <a class="chat-opt fb" href={site.messenger} target="_blank" rel="noopener" tabindex="-1">
      <span class="opt-label">Messenger</span>
      <span class="opt-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M12 2C6.5 2 2 6.14 2 11.25c0 2.88 1.42 5.45 3.66 7.14V22l3.35-1.84c.94.26 1.94.4 2.99.4 5.5 0 10-4.14 10-9.25S17.5 2 12 2zm1.06 12.44-2.56-2.73-4.99 2.73 5.49-5.82 2.62 2.72 4.93-2.72-5.49 5.82z"/>
        </svg>
      </span>
    </a>
  </div>

  <span class="nudge-label" aria-hidden="true">Chat with us!</span>
  <button
    class="chat-toggle"
    id="chat-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="chat-options"
    aria-label="Chat with us"
  >
    <svg class="icon-chat" viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
      <path d="M12 3C6.48 3 2 6.94 2 11.8c0 2.15.88 4.12 2.34 5.65-.18 1.13-.65 2.6-1.7 3.55 0 0 2.55-.14 4.53-1.52 1.46.6 3.1.92 4.83.92 5.52 0 10-3.94 10-8.8S17.52 3 12 3zM7.5 13.05c-.69 0-1.25-.56-1.25-1.25s.56-1.25 1.25-1.25 1.25.56 1.25 1.25-.56 1.25-1.25 1.25zm4.5 0c-.69 0-1.25-.56-1.25-1.25S11.31 10.55 12 10.55s1.25.56 1.25 1.25-.56 1.25-1.25 1.25zm4.5 0c-.69 0-1.25-.56-1.25-1.25s.56-1.25 1.25-1.25 1.25.56 1.25 1.25-.56 1.25-1.25 1.25z"/>
    </svg>
    <svg class="icon-close" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
      <path d="M18.3 5.71 12 12.01l-6.3-6.3-1.4 1.42 6.29 6.3-6.3 6.3 1.42 1.4 6.3-6.29 6.3 6.3 1.4-1.42-6.29-6.3 6.3-6.3z"/>
    </svg>
  </button>
</div>

<style>
  .chat-widget {
    align-items: flex-end;
    bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    position: fixed;
    right: 1.25rem;
    z-index: 95;
  }

  /* ---- Toggle button ---- */
  .chat-toggle {
    align-items: center;
    background: var(--teal);
    border: 0;
    border-radius: 50%;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    color: #ffffff;
    cursor: pointer;
    display: flex;
    height: 58px;
    justify-content: center;
    transition: background-color 0.15s ease, transform 0.25s ease;
    width: 58px;
  }
  .chat-toggle:hover { background: var(--teal-ink); transform: scale(1.06); }
  .chat-widget.open .chat-toggle { transform: rotate(90deg); }
  .chat-toggle .icon-close { display: none; }
  .chat-widget.open .chat-toggle .icon-chat { display: none; }
  .chat-widget.open .chat-toggle .icon-close { display: block; }

  /* ---- Options: hidden by default, animated reveal (bottom-up stagger) ---- */
  .chat-options {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    visibility: hidden;
  }
  .chat-widget.open .chat-options { visibility: visible; }
  .chat-opt {
    align-items: center;
    display: flex;
    gap: 0.6rem;
    justify-content: flex-end;
    opacity: 0;
    pointer-events: none;
    text-decoration: none;
    transform: translateY(12px) scale(0.9);
    transform-origin: right center;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .chat-widget.open .chat-opt {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  /* fb sits closest to the button — it appears first, wa follows */
  .chat-widget.open .chat-opt.fb { transition-delay: 0.03s; }
  .chat-widget.open .chat-opt.wa { transition-delay: 0.1s; }

  .opt-icon {
    align-items: center;
    border-radius: 50%;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
    color: #ffffff;
    display: flex;
    height: 48px;
    justify-content: center;
    transition: transform 0.15s ease;
    width: 48px;
  }
  .chat-opt:hover .opt-icon { transform: scale(1.08); }
  .chat-opt.wa .opt-icon { background: #25d366; }
  .chat-opt.fb .opt-icon { background: #0084ff; }
  .opt-label {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow-md);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.4rem 0.9rem;
    white-space: nowrap;
  }

  /* ---- Attention nudge: strong shake + double pulse ring + label ---- */
  @keyframes chat-shake {
    0%, 100% { transform: rotate(0) scale(1); }
    10% { transform: rotate(-16deg) scale(1.14); }
    20% { transform: rotate(13deg) scale(1.14); }
    30% { transform: rotate(-11deg) scale(1.12); }
    40% { transform: rotate(9deg) scale(1.1); }
    50% { transform: rotate(-7deg) scale(1.07); }
    60% { transform: rotate(5deg) scale(1.05); }
    70% { transform: rotate(-3deg) scale(1.02); }
    80%, 90% { transform: rotate(0) scale(1); }
  }
  @keyframes chat-ping {
    0% { box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25), 0 0 0 0 rgba(20, 160, 141, 0.6); }
    100% { box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25), 0 0 0 26px rgba(20, 160, 141, 0); }
  }
  .chat-widget.nudge .chat-toggle {
    animation: chat-shake 1.1s ease 2, chat-ping 1s ease-out 2;
  }
  .nudge-label {
    background: var(--teal-deep);
    border-radius: 999px;
    bottom: 1rem;
    box-shadow: var(--shadow-md);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    opacity: 0;
    padding: 0.45rem 1rem;
    pointer-events: none;
    position: absolute;
    right: calc(58px + 0.8rem);
    transform: translateX(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    white-space: nowrap;
  }
  .chat-widget.nudge .nudge-label { opacity: 1; transform: none; }
  .chat-widget.open .nudge-label { display: none; }

  @media (max-width: 720px) {
    /* stay above the sticky mobile enroll bar when present */
    :global(body.has-mobile-cta) .chat-widget { bottom: 5.6rem; }
  }
</style>

<script>
  const widget = document.getElementById('chat-widget');
  const toggle = document.getElementById('chat-toggle');
  const opts = document.querySelectorAll('#chat-options a');
  let interacted = false;
  let nudgeInterval: ReturnType<typeof setInterval> | undefined;

  function setOpen(open: boolean) {
    widget?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    // keep the hidden options out of the tab order
    opts.forEach((a) => a.setAttribute('tabindex', open ? '0' : '-1'));
  }

  function nudge() {
    if (interacted || widget?.classList.contains('open')) return;
    widget?.classList.add('nudge');
    // shake runs twice (~2.2s); label stays a moment longer
    setTimeout(() => widget?.classList.remove('nudge'), 3500);
  }

  toggle?.addEventListener('click', () => {
    interacted = true;
    if (nudgeInterval) clearInterval(nudgeInterval);
    const opening = !widget?.classList.contains('open');
    setOpen(opening);
    // Opening the widget is an intent signal in its own right — the visitor
    // wants to talk before picking a channel. Only the open, never the close.
    if (opening) {
      (window as any).MarketingKit?.track?.('chat_click', { page: location.pathname });
    }
  });

  // close when clicking anywhere else on the page
  document.addEventListener('click', (ev) => {
    if (widget?.classList.contains('open') && !widget.contains(ev.target as Node)) {
      setOpen(false);
    }
  });

  // first nudge shortly after load, then every 8s until first interaction
  setTimeout(nudge, 2000);
  nudgeInterval = setInterval(nudge, 8000);
</script>
