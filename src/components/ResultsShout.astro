---
// Achievement proof block — big numbers, few words. Every figure is
// computed from the transcribed results flyers (src/data/results.js),
// so it can never drift from what PLC actually published.
// Used on the homepage and the ads landing page.
import { resultSessions, resultStats } from '../data/results.js';

const {
  eyebrow = 'Proven Results',
  title = "Our Students Don't Just Improve — They Top Their Classes",
  text = 'Real outcomes from our last three published semesters of high school finals. Every number has names behind it.',
  band = false,
} = Astro.props;

const stats = resultStats();
const apPerfect = resultSessions[0].perfect; // 2024-25 Sem 2: AP Calc AB perfect 5s
---
<section class={`section${band ? ' band' : ''}`}>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="big-stats">
      <div class="big-stat">
        <div class="n">{stats.perfect}</div>
        <div class="l">Perfect scores</div>
      </div>
      <div class="big-stat">
        <div class="n">{stats.ninety}</div>
        <div class="l">Students scored 90%+</div>
      </div>
      <div class="big-stat">
        <div class="n">{stats.eighty}</div>
        <div class="l">Students scored 80%+</div>
      </div>
    </div>
    <div class="perfect-card">
      <div class="score-shout">
        <span class="score">{apPerfect.score}</span>
        <span class="score-meta">
          <span class="score-word">Perfect Score</span>
          <span class="score-subject">{apPerfect.subject} · 2024-25</span>
        </span>
      </div>
      <div class="chips">
        {apPerfect.students.map((n) => <span class="chip">{n}</span>)}
      </div>
    </div>
    <p class="text-center see-all">
      <a href="/results/">See every student and semester →</a>
    </p>
  </div>
</section>

<style>
  /* Big numbers, few words — loud without clutter */
  .big-stats {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 auto;
    max-width: 56rem;
    text-align: center;
  }
  @media (max-width: 640px) { .big-stats { gap: 1.75rem; grid-template-columns: 1fr; } }
  .big-stat .n {
    color: var(--teal-deep);
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5.8vw, 4rem);
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    line-height: 1;
  }
  .big-stat .l { color: var(--muted); font-size: 1.05rem; font-weight: 700; margin-top: 0.4rem; }
  /* The achievement, shouted: giant golden score on teal */
  .perfect-card {
    background: linear-gradient(120deg, var(--teal-deep), var(--teal-ink));
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin: 2.6rem auto 0;
    max-width: 44rem;
    padding: 1.4rem 1.8rem 1.5rem;
  }
  .score-shout {
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
  }
  .score {
    color: #ffd166;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.6vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 0.9;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }
  .score-meta { display: flex; flex-direction: column; gap: 0.15rem; }
  .score-word {
    color: #ffe9a8;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .score-subject { color: #ffffff; font-size: 1.1rem; font-weight: 700; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .chip {
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.3rem 0.9rem;
  }
  .see-all { margin-top: 1.6rem; }
  .see-all a { font-weight: 700; }
</style>
